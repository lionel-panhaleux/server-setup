[Unit]
Description=pg_dump backup of every database in the cluster
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
SyslogIdentifier=postgres-backup
Environment=BACKUP_DIR=/var/backups/postgres
Environment=RETENTION_DAYS=7
EnvironmentFile=/etc/postgres-backup/backup.env
EnvironmentFile=/etc/postgres-backup/remote.env
# Dead-man's-switch ping URLs; the '-' tolerates the file being absent.
EnvironmentFile=-/etc/postgres-backup/healthcheck.env
# Backups yield to the live workloads (pg_dump's compression is client-side CPU).
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/local/bin/pg-backup
